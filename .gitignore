.env
.env.local
*.local

# ── Editor ─────────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
.cursor/

# ── Local workspace (Cursor / one-offs — never commit) ─────────────────────
.local/

# ── Replit-specific (don't ship to GitHub) ─────────────────────────────────
.replit
replit.nix
replit.md
.config/
.upm/
.agents/
attached_assets/
screenshots/
# Anchor with leading / so we only exclude the repo-root Replit dev
# entrypoints, NOT apps/api/app/main.py (the real FastAPI app).
/main.py
/pyproject.toml

# ── App-generated logs ─────────────────────────────────────────────────────
apps/api/logs/
*.log

# ── Local/generated artifacts (do not commit) ──────────────────────────────
.venv-migrate/
.venv-docx/
*.tsbuildinfo
docs/infrastructure/
docs/exports/
docs/exports/*.json
docs/exports/**/*_export*.json
docs/reports/*.json
docs/reports/*.docx
docs/architecture/*.eraser
docs/architecture/NORAD_STAKEHOLDER_DIAGRAMS.md
# GCP ops — local secrets/artifacts only (copy from config.env.example)
ops/gcp-migration/config.env
ops/gcp-migration/connection.env
ops/gcp-migration/*.dump
ops/gcp-migration/cloud-sql-proxy
/PLAN.md
/JOURNAL.md
