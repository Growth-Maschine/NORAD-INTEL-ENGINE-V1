# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Comma-separated JSON array of allowed CORS origins.
# Local dev:  ["http://localhost:5000","http://127.0.0.1:5000"]
# Production: ["https://your-frontend.vercel.app"]
CORS_ORIGINS=["http://localhost:5000","http://127.0.0.1:5000"]

# ── LLM + research engines ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
PARALLEL_API_KEY=...
EXA_API_KEY=...
# Diffbot Knowledge Graph token — third research engine alongside Parallel/Exa.
# Grab from https://app.diffbot.com/ → Account → API Token.
DIFFBOT_API_KEY=...

# ── Postgres (GCP Cloud SQL) ─────────────────────────────────────────────────
# Runtime: asyncpg URL for the API (port 5432 + sslmode=require).
GCP_DATABASE_URL=postgresql+asyncpg://norad_app:PASSWORD@HOST:5432/norad?sslmode=require
# DDL / psql: sync URL (same host; use Cloud SQL Auth Proxy locally on 127.0.0.1).
GCP_DATABASE_URL_POOL=postgresql://norad_app:PASSWORD@HOST:5432/norad?sslmode=require
# Direct: same as POOL for Cloud SQL.
GCP_DATABASE_URL_DIRECT=postgresql://norad_app:PASSWORD@HOST:5432/norad?sslmode=require
# Scripts / GCP admin only — not read by the API at runtime
GCP_SQL_APP_PASSWORD=
GCP_SQL_ROOT_PASSWORD=
GCP_SQL_MIGRATE_PASSWORD=

# ── Redis (optional — /health/db connectivity probe) ─────────────────────────
REDIS_URL=rediss://default:<token>@<endpoint>.upstash.io:6379
