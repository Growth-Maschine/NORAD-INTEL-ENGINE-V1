# Copy to config.env and fill in (config.env is gitignored).
GCP_PROJECT=your-gcp-project-id
GCP_REGION=europe-west2
SQL_INSTANCE=norad-pg-prod
SQL_DATABASE=norad
SQL_APP_USER=norad_app
SQL_MIGRATE_USER=norad_migrate
SECRET_NAME=norad-db-password

# Optional: comma-separated CIDRs for Railway egress (find in Railway service settings).
# Example: 34.x.x.x/32
RAILWAY_AUTHORIZED_CIDRS=
